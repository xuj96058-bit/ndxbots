# Copy to /etc/ndxbots/paper.env on the server; do not commit the filled copy.
# Choose the explicit US SIMULATE account returned by `ndxbots.paper accounts`.
NDXBOTS_PAPER_ACCOUNT_ID=REPLACE_WITH_US_SIMULATE_ACCOUNT_ID

# OpenD login ID, NOT the trading account ID above. Prefer the Futu numeric ID.
# First complete interactive login and remember it as the `ndxbots` Linux user.
# No account password or trade password belongs in this file or either unit.
NDXBOTS_OPEND_LOGIN_ACCOUNT=REPLACE_WITH_FUTU_LOGIN_ID

FUTU_HOST=127.0.0.1
FUTU_PORT=11111
PYTHONUNBUFFERED=1
